<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="bg-zinc-900 w-full min-h-screen flex items-center justify-center text-white">
        
        <form class="bg-zinc-800 p-8 rounded-2xl flex flex-col gap-4 w-80" action="/register" method="post">
            <h3 class="text-3xl font-bold">Create Account</h3>
            <input class="bg-zinc-700 px-4 py-2 rounded-lg outline-none" type="text" placeholder="name" name="name">
            <input class="bg-zinc-700 px-4 py-2 rounded-lg outline-none" type="text" placeholder="username" name="username">
            <input class="bg-zinc-700 px-4 py-2 rounded-lg outline-none" type="email" placeholder="email" name="email">
            <input class="bg-zinc-700 px-4 py-2 rounded-lg outline-none" type="password" placeholder="password" name="password">
            <input class="bg-zinc-700 px-4 py-2 rounded-lg outline-none" type="number" placeholder="age" name="age">
            <input class="bg-blue-600 hover:bg-blue-700 py-2 rounded-lg cursor-pointer font-semibold" type="submit" value="Create Account">
        </form>
    </div>
</body>
</html>