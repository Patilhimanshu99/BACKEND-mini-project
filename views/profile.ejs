<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="bg-zinc-900 w-full min-h-screen p-10 text-white">
        <div class="w-full flex justify-end">
            <a href="/logout" class="bg-red-500 rounded-md px-3 py-2 text-sm mb-5 inline-block">Logout</a>
        </div>
        <div class="flex items-start gap-3">
            <div class="rounded-full overflow-hidden w-12 h-12">
                <img class="w-full h-full object-cover" src="/images/uploads/<%= user.profilepic %>" alt="">
            </div>
            <h3 class="text-2xl font-bold"><span class="font-light">Hello</span>, <%= user.name %>👋</h3> 
        </div>
        
        <h5 class="mb-5 mt-3">Create a new post.</h5>
        <form method="post"  action="/post">
            <textarea placeholder="What's in Your Mind ?" class="w-1/3 block outline-none resize-none bg-transparent border-2 border-zinc-800 rounded-lg p-3" name="content"></textarea>
            <input type="submit" class="w-40 px-3 text-sm py-2 bg-blue-500 block rounded-md mt-2" value="Create New Post">
        </form>

        <div class="posts mt-20">
            <h3 class="text-zinc-400">Your Posts....</h3>
            <div class="postcontainer mt-5">
                <% user.posts.reverse().forEach(function(post){ %> 
                    <div class="post mb-4 w-1/3 border-[1px] bg-zinc-800 border-zinc-700 p-4 rounded-md">
                        <h4 class="font-bold text-blue-500 mb-2 text-xl">@<%= user.username %></h4>
                        <p class="text-sm tracking-tight"><%= post.content %></p>
                        <small class="mt-2 inline-block"><%= post.likes.length %> Likes</small>
                        <div class="btns flex gap-4">
                            <a class="bg-red-600 rounded-lg mt-1" href="/like/<%= post._id %>"> <%= post.likes.indexOf(user._id) === -1 ? "Like👍" : "Unlike👎🏻" %></a>
                            <a class="text-zinc-500 rounded-md mt-2" href="/edit/<%= post._id %>"> Edit</a>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
</body>
</html>