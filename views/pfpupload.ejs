<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="bg-zinc-900 w-full min-h-screen flex items-center justify-center text-white">
        
        <form autocomplete="off" action="/upload" method="post" enctype="multipart/form-data" class="bg-zinc-800 p-8 rounded-2xl flex flex-col gap-4 w-80">
            <h3 class="text-3xl font-bold">Upload a Profile picture</h3>
            <input type="file" name="image">
            <input class="bg-blue-600 hover:bg-blue-700 py-2 rounded-lg cursor-pointer font-semibold" type="submit" value="Upload File">
        </form>
    </div>
</body>
</html>