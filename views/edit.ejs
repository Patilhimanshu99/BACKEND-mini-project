<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="bg-zinc-900 w-full min-h-screen p-10 text-white">
        <div class="w-full flex justify-end">
            <a href="/logout" class="bg-red-500 rounded-md px-3 py-2 text-sm mb-5 inline-block">Logout</a>
        </div>
        
        <h1 class="mb-5 font-bold">Edit Your Post.</h1>
        
        <form method="post"  action="/update/<%= post._id %>">
            <textarea placeholder="What's in Your Mind ?" class="w-1/3 block outline-none resize-none bg-transparent border-2 border-zinc-800 rounded-lg p-3" name="content"><%= post.content %></textarea>
            <input type="submit" class="w-40 px-3 text-sm py-2 bg-yellow-700 text-black font-bold block rounded-md mt-2" value="Update changes">
        </form>

    </div>
</body>
</html>